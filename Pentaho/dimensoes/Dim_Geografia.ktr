  <step>
    <name>TR - Corrige Código IBGE (Java)</name>
    <type>UserDefinedJavaClass</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <definitions>
      <definition>
        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source>import java.util.HashMap;
import java.util.Map;

private Map&lt;String, String> mapaIBGE;

public boolean processRow(StepMetaInterface smi, StepDataInterface sdi) throws KettleException {
    if (first) {
        first = false;
        mapaIBGE = new HashMap&lt;String, String>();

        RowSet fluxoIBGE = findInfoRowSet("BaseIBGE");
        
        if (fluxoIBGE == null) {
            throw new KettleException("Info step 'BaseIBGE' não encontrado. Verifique a configuração na aba inferior.");
        }

        Object[] linhaIBGE = null;
        while ((linhaIBGE = getRowFrom(fluxoIBGE)) != null) {
            String municipio = get(Fields.Info, "nm_municipio").getString(linhaIBGE);
            String codCorreto = get(Fields.Info, "cod_ibge").getString(linhaIBGE);

            if (municipio != null &amp;&amp; codCorreto != null) {
                mapaIBGE.put(municipio.trim().toUpperCase(), codCorreto.trim());
            }
        }
    }

    Object[] r = getRow();
    if (r == null) {
        setOutputDone();
        return false;
    }

    r = createOutputRow(r, data.outputRowMeta.size());

    String municipioPrincipal = get(Fields.In, "nm_municipio").getString(r);

    if (municipioPrincipal != null) {
        String codigoCorreto = (String) mapaIBGE.get(municipioPrincipal.trim().toUpperCase());

        if (codigoCorreto != null) {
            get(Fields.Out, "cod_ibge").setValue(r, codigoCorreto);
        }
    }

    putRow(data.outputRowMeta, r);
    return true;
}</class_source>
      </definition>
    </definitions>
